            xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/">
         <pdfx:Copyright>Copyright ¬©‚Ç¨1996-1998, 2000, 2004-2011 ARM. All rights reserved.</pdfx:Copyright>
      </rdf:Description>
